# auto (default): official sources with bundled-snapshot fallback | live | snapshot
MONETARY_DATA_MODE=auto
# Optional: FRED API key (keyless CSV endpoint is used otherwise)
FRED_API_KEY=
# Comma-separated frontend origins allowed by CORS (only needed if the browser calls the API directly)
MONETARY_CORS_ORIGINS=http://localhost:3000
MONETARY_HTTP_TIMEOUT=20
